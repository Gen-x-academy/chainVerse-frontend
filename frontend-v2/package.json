  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "analyze": "ANALYZE=true next build",
    "check:production-imports": "node scripts/check-no-production-imports.mjs",
    "loadtest:deadline": "node --experimental-strip-types scripts/load-tests/scholarship-deadline-burst.ts",
    "test": "vitest run",

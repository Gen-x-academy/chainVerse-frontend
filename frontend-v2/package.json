    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.1.3",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",

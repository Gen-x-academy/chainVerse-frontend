# Backend API base URL (used by api-client.ts)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Stellar / Soroban network passphrase
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Google OAuth client ID (for social login)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# App URL (used for redirect callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: enable bundle analyzer (set to "true" to analyse)
ANALYZE=false
